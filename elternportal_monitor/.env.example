# Elternportal (Pflicht)
PORTAL_BASE_URL=https://example.eltern-portal.org
ELTERNPORTAL_USERNAME=
ELTERNPORTAL_PASSWORD=
# 0 = aktuell ausgewähltes/einziges Kind; bei mehreren Kindern die Portal-ID verwenden.
ELTERNPORTAL_CHILD_ID=0

# Ausführung
MODE=once
POLL_INTERVAL_MINUTES=60
STATE_FILE=./data/state.json
APP_TIMEZONE=Europe/Berlin
DAILY_SUMMARY=true
DAILY_EMAIL_HOUR=6
INCLUDE_LETTER_BODY=false

# SMTP (für E-Mail alle Werte setzen)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Home Assistant (optional)
HA_URL=
HA_TOKEN=
# Beispiel: mobile_app_mein_handy (ohne das Präfix notify.)
HA_NOTIFY_SERVICE=

# MQTT (empfohlene Home-Assistant-Anbindung; in der HA-App automatisch erkannt)
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_BASE_TOPIC=elternportal
